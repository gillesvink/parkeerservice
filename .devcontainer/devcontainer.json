{
    "image": "docker.io/rust:1.90-trixie",
    "customizations": {
        "vscode": {
            "extensions": [
                "streetsidesoftware.code-spell-checker",
                "rust-lang.rust-analyzer",
                "VisualStudioExptTeam.vscodeintellicode",
                "tamasfe.even-better-toml"
            ]
        }
    },
    "postCreateCommand": "rustup component add clippy && rustup component add rustfmt"
}